{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/repair-contract.schema.json",
  "title": "S8 RepairContract",
  "description": "The S8 root-cause repair authorization consumed by S9. A draft becomes authoritative only after the runtime records approval and its hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repair_contract_id", "case_id", "revision", "status", "source_finding_ids",
    "root_cause_statement", "violated_invariant", "causal_model_ref", "architecture_intent", "repair_units",
    "prospective_scope", "forbidden_scope", "symptom_assertions", "root_invariant_assertions",
    "detection_gap_assertions", "stop_escalation_conditions"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "repair_contract_id": {"type": "string", "pattern": "^repair-contract-[A-Za-z0-9._-]+$"},
    "case_id": {"type": "string", "pattern": "^investigation-case-[A-Za-z0-9._-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved"]},
    "source_finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "root_cause_statement": {"type": "string", "minLength": 1},
    "violated_invariant": {"type": "string", "minLength": 1},
    "causal_model_ref": {"type": "string", "minLength": 1},
    "architecture_intent": {"type": "string", "minLength": 1},
    "repair_units": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "anyOf": [{"pattern": "^(symptom|root|gap)-[0-9]+$"}, {"const": "all"}]}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resource_locks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }}
    },
    "prospective_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "compatibility_migration": {"type": "string"},
    "symptom_assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "root_invariant_assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "detection_gap_assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "regression_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stop_escalation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"]},
    "approver_id": {"type": ["string", "null"]},
    "approval_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  }
}
