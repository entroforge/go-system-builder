{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/finding.schema.json",
  "title": "S7 Immutable Finding",
  "description": "One immutable observation fact extracted from a failed Claim (L3-S7 §3.6). Findings state observable symptoms with a real encounter; they never carry root cause, repair scope, or suggested fixes — causal judgment belongs to S8.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "claim_id",
    "lens",
    "severity",
    "expected",
    "authority_refs",
    "observed",
    "observation_mode",
    "encounter",
    "reproducibility",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^finding-[A-Za-z0-9._-]+$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^claim-[A-Za-z0-9._-]+$"
    },
    "lens": {
      "enum": ["delivery", "qa", "e2e"]
    },
    "severity": {
      "enum": ["P0", "P1", "P2", "P3"],
      "description": "P0/security/data-destructive findings stop the line: the ObservationBatch seals immediately with explicit capture gaps instead of draining the remaining Claims."
    },
    "blocking": {
      "type": "boolean",
      "description": "Explicit business-blocking marker (RC-02, L3-S7 §10.1). The Reviewer's business judgment that this Finding blocks the business flow regardless of severity; P0 Findings are implicitly blocking=true and may omit the field. A blocking Finding's canonical BUG blocks the clean round until closed with targeted re-verification."
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "description": "REQ/contract/CASE/PATH/Closing Contract sources for the expected behavior.",
      "items": {"type": "string", "minLength": 1}
    },
    "observed": {
      "type": "string",
      "minLength": 1,
      "description": "The actual observable symptom. No cause judgment."
    },
    "observation_mode": {
      "enum": ["user_flow", "api_flow", "command_flow", "state_transition", "code_inspection"]
    },
    "encounter": {
      "type": "object",
      "description": "The real operation scene of THIS observation — not a future reproduction script. Per-mode minimum fields are enforced by allOf rules and the submit validator (L3-S7 §3.6).",
      "additionalProperties": false,
      "required": ["journey_summary", "wall_action", "first_bad_checkpoint"],
      "properties": {
        "journey_summary": {
          "type": "string",
          "minLength": 8,
          "description": "1-3 sentences: entry/goal -> key action -> wall action -> first anomaly/terminal state."
        },
        "entrypoint": {"type": "string"},
        "scenario_ref": {"type": "string"},
        "runtime_context": {"type": "string"},
        "actor_context": {"type": "string"},
        "initial_state_ref": {"type": "string"},
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "action", "observed_checkpoint"],
            "properties": {
              "sequence": {"type": "integer", "minimum": 1},
              "action": {"type": "string", "minLength": 1},
              "target": {"type": "string"},
              "input_ref": {"type": "string"},
              "observed_checkpoint": {"type": "string", "minLength": 1},
              "evidence_refs": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "last_good_checkpoint": {"type": "string"},
        "wall_action": {
          "type": "string",
          "minLength": 1,
          "description": "The action/request/command/transition that exposed the first deviation. Does not imply root cause."
        },
        "first_bad_checkpoint": {
          "type": "string",
          "minLength": 1,
          "description": "The earliest confirmable deviation; not necessarily the final error message."
        },
        "blocked_continuation": {"type": "string"},
        "terminal_state": {"type": "string"},
        "state_delta_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "side_effects": {
          "type": "array",
          "items": {"type": "string"}
        },
        "attempt_variants": {
          "type": "array",
          "items": {"type": "string"}
        },
        "capture_gaps": {
          "type": "array",
          "description": "Scene evidence that could not be captured (safety/permission/tooling) and the investigation impact.",
          "items": {"type": "string"}
        },
        "cleanup_state": {"type": "string"},
        "request_summary": {"type": "string"},
        "response_summary": {"type": "string"},
        "command": {"type": "string"},
        "exit_code": {"type": "integer"},
        "before_state": {"type": "string"},
        "after_state": {"type": "string"},
        "inspection_entry": {"type": "string"},
        "symbol_trail": {"type": "string"}
      }
    },
    "reproducibility": {
      "enum": ["always", "intermittent", "once_with_deterministic_trace"],
      "description": "Records what the already-executed samples showed. Never re-run dangerous operations to fill this field."
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "description": "Typed refs: trace, request/response, console, screenshot, video, data snapshot, command output.",
      "items": {"type": "string", "minLength": 1}
    },
    "correlation_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "visible_impact": {"type": "string"},
    "negative_facts": {
      "type": "array",
      "description": "Adjacent behaviors that still work; helps S8 eliminate hypotheses.",
      "items": {"type": "string"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "hypotheses": {
      "type": "array",
      "description": "Optional leads, always unverified; never a routing authority.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "status"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "status": {"const": "unverified"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"observation_mode": {"const": "user_flow"}}},
      "then": {"properties": {"encounter": {"required": ["journey_summary", "wall_action", "first_bad_checkpoint", "entrypoint", "timeline", "terminal_state"]}}}
    },
    {
      "if": {"properties": {"observation_mode": {"const": "api_flow"}}},
      "then": {"properties": {"encounter": {"required": ["journey_summary", "wall_action", "first_bad_checkpoint", "entrypoint", "request_summary", "response_summary", "terminal_state"]}}}
    },
    {
      "if": {"properties": {"observation_mode": {"const": "command_flow"}}},
      "then": {"properties": {"encounter": {"required": ["journey_summary", "wall_action", "first_bad_checkpoint", "command", "exit_code", "terminal_state"]}}}
    },
    {
      "if": {"properties": {"observation_mode": {"const": "state_transition"}}},
      "then": {"properties": {"encounter": {"required": ["journey_summary", "wall_action", "first_bad_checkpoint", "before_state", "after_state", "terminal_state"]}}}
    },
    {
      "if": {"properties": {"observation_mode": {"const": "code_inspection"}}},
      "then": {"properties": {"encounter": {"required": ["journey_summary", "wall_action", "first_bad_checkpoint", "inspection_entry", "symbol_trail"]}}}
    }
  ]
}
