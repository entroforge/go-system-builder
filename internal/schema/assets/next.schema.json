{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/next.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "protocol_ref", "objective", "action", "read", "primary_skill", "missing", "done_when", "then", "human_required"],
  "properties": {
    "stage": {"type": "string", "minLength": 1},
    "protocol_ref": {"type": "string", "pattern": "^docs/agent-protocol\\.md#.+$"},
    "objective": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "read": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "primary_skill": {"type": "string", "minLength": 1},
    "missing": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "done_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "then": {"const": "recompute"},
    "human_required": {"type": "boolean"},
    "change_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "check_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
