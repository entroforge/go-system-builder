{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/e2e-runner-profile.schema.json",
  "title": "Protected controlled E2E runner profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "config",
    "source_roots",
    "node",
    "modules",
    "browsers",
    "system",
    "isolator",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "kernel_release"
      ],
      "properties": {
        "os": {
          "const": "linux"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "kernel_release": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "source_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800
    },
    "node": {
      "$ref": "#/$defs/tool"
    },
    "modules": {
      "$ref": "#/$defs/tool"
    },
    "browsers": {
      "$ref": "#/$defs/tool"
    },
    "system": {
      "$ref": "#/$defs/tool"
    },
    "isolator": {
      "$ref": "#/$defs/tool"
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\u0000\r\n]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
