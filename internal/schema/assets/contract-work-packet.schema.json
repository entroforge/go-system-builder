{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "template_id",
    "template_sha256",
    "binding",
    "view_path",
    "answer_path",
    "draft",
    "inputs"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "const": "s3-contract-v1"
    },
    "template_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "generation",
        "stage_entry",
        "stage",
        "owner",
        "requirement"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "stage_entry": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "const": "S3"
        },
        "owner": {
          "const": "Main"
        },
        "requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "view_path": {
      "type": "string",
      "minLength": 1
    },
    "answer_path": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "instruction",
        "read",
        "questions",
        "answer"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "read": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "purpose"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conclusion",
            "index_path",
            "contract_paths",
            "applicability"
          ],
          "properties": {
            "conclusion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "example": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "expected",
                    "observed"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "observed": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "index_path": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "example": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "expected",
                    "observed"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "observed": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "contract_paths": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "example": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "expected",
                    "observed"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "observed": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "applicability": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "example": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "expected",
                    "observed"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "observed": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conclusion",
            "index_path",
            "contract_paths",
            "applicability"
          ],
          "properties": {
            "conclusion": {
              "enum": [
                null,
                "pass"
              ]
            },
            "index_path": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 512
            },
            "contract_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "applicability": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "FE": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "disposition",
                    "rationale"
                  ],
                  "properties": {
                    "disposition": {
                      "enum": [
                        "required",
                        "not_applicable"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                },
                "BE": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "disposition",
                    "rationale"
                  ],
                  "properties": {
                    "disposition": {
                      "enum": [
                        "required",
                        "not_applicable"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                },
                "SYNC": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "disposition",
                    "rationale"
                  ],
                  "properties": {
                    "disposition": {
                      "enum": [
                        "required",
                        "not_applicable"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designs",
        "sources",
        "directories"
      ],
      "properties": {
        "designs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "sources": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "version",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "directories": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/contract-work-packet.schema.json"
}
