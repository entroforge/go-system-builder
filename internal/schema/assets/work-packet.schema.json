{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/work-packet.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_id",
    "template_id",
    "binding",
    "inputs",
    "answer_path",
    "view_path",
    "draft"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "const": "s5-document-review-v1"
    },
    "binding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "runtime_id",
        "generation",
        "stage_entry",
        "owner",
        "assignment_id",
        "responsibility",
        "attempt"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "stage_entry": {
          "type": "integer",
          "minimum": 0
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "responsibility": {
          "enum": [
            "DV-SPEC-CONSISTENCY",
            "DV-TASK-EXECUTABILITY"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "previous_submission_key": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "revision_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "execution_required": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attempt": {
                "const": 1
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "previous_submission_key"
                  ]
                },
                {
                  "required": [
                    "revision_reason"
                  ]
                },
                {
                  "required": [
                    "execution_required"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "previous_submission_key",
              "revision_reason"
            ]
          }
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "path",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "answer_path": {
      "type": "string",
      "minLength": 1
    },
    "view_path": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "instruction",
        "read",
        "questions",
        "answer"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "read": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "purpose"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conclusion",
            "findings"
          ],
          "properties": {
            "conclusion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "example": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "expected",
                    "observed"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "observed": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "findings": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question"
              ],
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "example": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "expected",
                    "observed"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    },
                    "observed": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conclusion",
            "findings"
          ],
          "properties": {
            "conclusion": {
              "enum": [
                null,
                "pass",
                "fix_required",
                "req_change_required"
              ]
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "expected",
                  "observed"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "expected": {
                    "type": "string"
                  },
                  "observed": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "purpose"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(\\.claude/)?skills/[A-Za-z0-9._-]+/SKILL\\.md$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task_analysis": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "parser_version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.claude/work-packets/analysis/[^\\\\:]+\\.json$"
        },
        "parser_version": {
          "const": "1.0.0"
        }
      }
    }
  }
}
