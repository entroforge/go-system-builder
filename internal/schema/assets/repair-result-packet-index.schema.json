{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair-result-packet-index.schema.json",
  "title": "S9 RepairResult WorkPacket immutable body index",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_id",
    "template_id",
    "binding",
    "result_id",
    "issuance_event_id",
    "view_path",
    "answer_path",
    "storage_format",
    "body_ref",
    "execution_locator"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "template_id": {
      "const": "s9-repair-result-v1"
    },
    "binding": {
      "$ref": "repair-result-work-packet.schema.json#/$defs/binding"
    },
    "result_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "issuance_event_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "view_path": {
      "type": "string",
      "pattern": "^$|^\\.claude/work-packets(-alt-[1-9][0-9]*)?/[^\\\\:#]+\\.json$"
    },
    "answer_path": {
      "type": "string",
      "pattern": "^\\.claude/submissions(-alt-[1-9][0-9]*)?/[^\\\\:#]+/[^\\\\:#]+/answer\\.json$"
    },
    "storage_format": {
      "const": "packet-body-ref-v1"
    },
    "body_ref": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "format",
        "path"
      ],
      "properties": {
        "format": {
          "const": "packet-json-v1"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.claude/packet-bodies(-alt-[1-9][0-9]*)?/([0-9a-f]{64}\\.json|(p|alternate-[0-9]+)/([A-Za-z0-9_-]{1,120}/)*[A-Za-z0-9_-]{1,120}\\.json)$"
        }
      }
    },
    "execution_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "execution_generation",
        "worktree_path"
      ],
      "properties": {
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_generation": {
          "type": "integer",
          "minimum": 1
        },
        "worktree_path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
