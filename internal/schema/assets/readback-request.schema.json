{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/readback-request.schema.json",
  "title": "Loop Readback Request",
  "description": "Schema for the readback request template used by `loop-harness team launch --request-template=...`. The documents array MUST use bottom-up order so the launch generator can resolve BUG -> TASK -> contract -> REQ -> design without re-sorting.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "message_type",
    "documents",
    "skills",
    "scope",
    "closing_contract_ref",
    "readback_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "message_type": {
      "const": "readback_request"
    },
    "message_id":          { "type": "string" },
    "correlation_id":      { "type": "string" },
    "runtime_id":          { "type": "string" },
    "expected_runtime_revision": { "type": "integer" },
    "agent_id":            { "type": "string" },
    "agent_definition_ref": { "type": "string" },
    "task_id":             { "type": "string" },
    "bug_id":              { "type": ["string", "null"] },
    "team_id":             { "type": ["string", "null"] },
    "occurred_at":         { "type": "string" },
    "role_family":         { "type": "string" },
    "documents": {
      "type": "array",
      "minItems": 3,
      "description": "Fingerprinted document references in strict bottom-up reading order. The first three positions MUST be task/contract/req (or four positions bug/task/contract/req when bug_id is set); see the allOf if/then rules below.",
      "$comment": "BUG-002: this schema encodes the bottom-up order constraint that was previously enforced only at launch time by internal/team/launch.go:validateDocumentOrder. The schema fires first; launch.go is redundant backup.",
      "items": {
        "$ref": "#/$defs/documentReference"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "scope": {
      "type": "object"
    },
    "closing_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "readback_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "documentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "version", "sha256", "read_order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["bug", "task", "contract", "req", "design", "prototype", "adr"]
        },
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "read_order": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "allOf": [
    {
      "description": "When no bug is present, the first three documents MUST be task, contract, req with read_order 1, 2, 3 respectively.",
      "if": {
        "not": {
          "required": ["bug_id"],
          "properties": {
            "bug_id": { "type": "string", "minLength": 1 }
          }
        }
      },
      "then": {
        "properties": {
          "documents": {
            "prefixItems": [
              {
                "type": "object",
                "required": ["kind", "read_order"],
                "properties": {
                  "kind": { "const": "task" },
                  "read_order": { "const": 1 }
                }
              },
              {
                "type": "object",
                "required": ["kind", "read_order"],
                "properties": {
                  "kind": { "const": "contract" },
                  "read_order": { "const": 2 }
                }
              },
              {
                "type": "object",
                "required": ["kind", "read_order"],
                "properties": {
                  "kind": { "const": "req" },
                  "read_order": { "const": 3 }
                }
              }
            ]
          }
        }
      }
    },
    {
      "description": "When bug_id is set, the first four documents MUST be bug, task, contract, req with read_order 1, 2, 3, 4 respectively.",
      "if": {
        "required": ["bug_id"],
        "properties": {
          "bug_id": { "type": "string", "minLength": 1 }
        }
      },
      "then": {
        "properties": {
          "documents": {
            "prefixItems": [
              {
                "type": "object",
                "required": ["kind", "read_order"],
                "properties": {
                  "kind": { "const": "bug" },
                  "read_order": { "const": 1 }
                }
              },
              {
                "type": "object",
                "required": ["kind", "read_order"],
                "properties": {
                  "kind": { "const": "task" },
                  "read_order": { "const": 2 }
                }
              },
              {
                "type": "object",
                "required": ["kind", "read_order"],
                "properties": {
                  "kind": { "const": "contract" },
                  "read_order": { "const": 3 }
                }
              },
              {
                "type": "object",
                "required": ["kind", "read_order"],
                "properties": {
                  "kind": { "const": "req" },
                  "read_order": { "const": 4 }
                }
              }
            ]
          }
        }
      }
    }
  ]
}