{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/stage-answer-s9-plan.schema.json",
  "description": "Local files in top-level and nested Result evidence_refs use the registered Builder source root, never Main. Result reception captures path: files (no author hash needed), slash-containing relative file refs and absolute files contained in that root; URI refs remain unchanged and bare tokens remain opaque identifiers (use path:check.log or ./check.log for a local filename). Migration, rollback and detection-gap artifact references keep their original meaning and are not captured. Missing Result source files require restoring the original source before reception. Plan-only refs retain their original source context and are not captured by the Result receiver.",
  "title": "S9 PlanReport authoring answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "instruction", "read", "questions", "answer"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "read": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    },
    "questions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "red_checks", "proposed_paths"],
      "properties": {
        "plan": {"$ref": "#/$defs/question"},
        "red_checks": {"$ref": "#/$defs/question"},
        "proposed_paths": {"$ref": "#/$defs/question"}
      }
    },
    "answer": {"$ref": "#/$defs/answer"}
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "expected", "observed"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "expected": {"type": "string", "minLength": 1},
            "observed": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "red_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "result", "evidence_refs"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 1024},
        "command": {"type": "string", "minLength": 1, "maxLength": 8192},
        "result": {"enum": ["fail", "pass", "blocked"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "red_checks", "proposed_paths"],
      "properties": {
        "plan": {"type": ["string", "null"], "maxLength": 32768},
        "red_checks": {
          "type": ["array", "null"],
          "maxItems": 128,
          "items": {"$ref": "#/$defs/red_check"}
        },
        "proposed_paths": {
          "type": ["array", "null"],
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  }
}
