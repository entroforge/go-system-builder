{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair-plan-report-packet-index.schema.json",
  "title": "S9 PlanReport WorkPacket immutable body index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "template_id",
    "binding",
    "report_id",
    "issuance_event_id",
    "view_path",
    "answer_path",
    "storage_format",
    "body_ref"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "template_id": {
      "const": "s9-plan-report-v1"
    },
    "template_sha256": {},
    "binding": {
      "$ref": "repair-plan-report-work-packet.schema.json#/$defs/binding"
    },
    "report_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "issuance_event_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "brief_path": {
      "type": "string",
      "minLength": 1
    },
    "view_path": {
      "type": "string",
      "pattern": "^$|^\\.claude/work-packets(-alt-[1-9][0-9]*)?/[^\\\\:#]+\\.json$"
    },
    "answer_path": {
      "type": "string",
      "pattern": "^\\.claude/submissions(-alt-[1-9][0-9]*)?/[^\\\\:#]+/answer\\.json$"
    },
    "storage_format": {
      "const": "packet-body-ref-v1"
    },
    "body_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path"
      ],
      "properties": {
        "format": {
          "const": "packet-json-v1"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.claude/packet-bodies(-alt-[1-9][0-9]*)?/([0-9a-f]{64}\\.json|(p|alternate-[0-9]+)/([A-Za-z0-9_-]{1,120}/)*[A-Za-z0-9_-]{1,120}\\.json)$"
        },
        "sha256": {},
        "size_bytes": {}
      }
    }
  }
}
