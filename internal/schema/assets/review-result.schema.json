{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/review-result.schema.json",
  "title": "S7 Canonical ReviewResult",
  "description": "The original professional answer for one Reviewer responsibility. Natural events receive the author's actual conclusions and observations; unfinished work and cross-responsibility observations remain visible without changing another owner's result.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "result_id",
    "assignment_id",
    "assignment_revision",
    "review_plan_id",
    "baseline_generation",
    "producer_agent_id",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "result_id": {
      "type": "string",
      "pattern": "^review-result-[A-Za-z0-9._-]+$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^assignment-[A-Za-z0-9._-]+$"
    },
    "assignment_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "The ReviewPlan/Assignment revision observed before execution; stale revisions are not submittable."
    },
    "review_plan_id": {
      "type": "string",
      "pattern": "^review-plan-[A-Za-z0-9._-]+$"
    },
    "baseline_generation": {
      "type": "integer",
      "minimum": 0
    },
    "producer_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_results": {
      "type": "array",
      "description": "Actual observations and conclusions; omitted work does not imply PASS. Cross-responsibility observations do not update the other owner's result.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "conclusion"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "conclusion": {
            "enum": [
              "pass",
              "fail",
              null
            ]
          },
          "method": {
            "type": "string"
          },
          "observed": {
            "type": "string",
            "description": "What the Reviewer actually observed for this Claim."
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "blocked_claims": {
      "type": "array",
      "description": "Actual unfinished work and obstacles. Environment, tools and capacity can be reported without inventing a product Finding; another responsibility's obstacle is preserved as an observation.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "blocking_finding_ids": {
            "type": "array",
            "description": "Actual related Findings, when available.",
            "items": {
              "type": "string"
            }
          },
          "failed_precondition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "build",
                  "start",
                  "entry",
                  "precondition",
                  "environment",
                  "tool",
                  "permission"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "after_repair_required": {
            "type": "boolean",
            "description": "Whether this observation needs validation after a repair, when applicable."
          }
        }
      }
    },
    "site_lost": {
      "type": "array",
      "description": "Actual gaps in the available observation and their impact; retain the Finding and hand off the unknowns.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Actual Findings and their observations; their granularity follows the author's professional judgment.",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "finding",
        "blocked",
        "req_change_required",
        "release_blocked"
      ],
      "description": "Use finding for actual Findings, blocked for unfinished work without a Finding, pass for completed work, and the pause verdicts for actual decisions."
    }
  }
}
