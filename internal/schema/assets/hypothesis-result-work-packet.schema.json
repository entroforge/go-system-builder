{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/hypothesis-result-work-packet.schema.json",
  "title": "S8 HypothesisResult work packet",
  "description": "Neutral authoring projection only. Original InvestigationCase, ObservationBatch, registered Assignment and Runtime evidence remain authoritative; the receiver rechecks every source and route tuple.",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "template_id", "template_sha256", "binding", "inputs", "result_id", "issuance_event_id", "view_path", "answer_path", "draft"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^packet-[a-f0-9]{64}$"},
    "template_id": {"const": "s8-hypothesis-result-v1"},
    "template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {"$ref": "#/$defs/binding"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "result_id": {"type": "string", "pattern": "^hypothesis-result-[a-f0-9]{64}$"},
    "issuance_event_id": {"type": "string", "minLength": 1},
    "view_path": {"type": "string", "pattern": "^\\.claude/work-packets/"},
    "answer_path": {"type": "string", "pattern": "^\\.claude/submissions/"},
    "draft": {"$ref": "stage-answer-s8.schema.json"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "baseline_generation", "review_round", "case_id", "case_ref", "case_sha256", "case_revision", "case_route_sha256", "source_finding_ids", "hypothesis_id", "hypothesis_question_sha256", "hypothesis_source_finding_ids", "assignment_id", "assignment_sha256", "team_id", "task_id", "task_ref", "task_sha256", "manifest_ref", "manifest_sha256", "owner_agent_id"],
      "properties": {
        "runtime_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "baseline_generation": {"type": "integer", "minimum": 0},
        "review_round": {"type": "integer", "minimum": 1},
        "case_id": {"type": "string", "pattern": "^investigation-case-[A-Za-z0-9._-]+$"},
        "case_ref": {"$ref": "#/$defs/relative_ref"},
        "case_sha256": {"$ref": "#/$defs/sha256"},
        "case_revision": {"type": "integer", "minimum": 1},
        "case_route_sha256": {"$ref": "#/$defs/sha256"},
        "observation_batch_id": {"type": "string", "pattern": "^observation-batch-[A-Za-z0-9._-]+$"},
        "observation_batch_ref": {"$ref": "#/$defs/relative_ref"},
        "observation_batch_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_digest": {"$ref": "#/$defs/sha256"},
        "source_finding_ids": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "pattern": "^finding-[A-Za-z0-9._-]+$"}},
        "hypothesis_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "hypothesis_question_sha256": {"$ref": "#/$defs/sha256"},
        "hypothesis_source_finding_ids": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "pattern": "^finding-[A-Za-z0-9._-]+$"}},
        "assignment_id": {"type": "string", "pattern": "^assignment-[A-Za-z0-9._-]+$"},
        "assignment_sha256": {"$ref": "#/$defs/sha256", "description": "SHA-256 of canonical JSON for the exact selected registered Assignment object; manifest SHA is retained separately."},
        "team_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "task_ref": {"$ref": "#/$defs/relative_ref"},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_ref": {"$ref": "#/$defs/relative_ref"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "owner_agent_id": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "case_route", "findings", "evidence_refs"],
      "properties": {
        "hypothesis": {"$ref": "#/$defs/hypothesis"},
        "case_route": {"$ref": "#/$defs/case_route"},
        "findings": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/finding_source"}},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/evidence_source"}}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "assignment_id", "statement", "invariant", "discriminator", "expected_outcomes", "source_finding_ids", "evidence_refs", "status"],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "assignment_id": {"type": "string", "pattern": "^assignment-[A-Za-z0-9._-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "invariant": {"type": "string", "minLength": 1},
        "discriminator": {"type": "string", "minLength": 1},
        "expected_outcomes": {"$ref": "#/$defs/expected_outcomes"},
        "source_finding_ids": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"type": "string", "pattern": "^finding-[A-Za-z0-9._-]+$"}},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "string", "minLength": 1}},
        "status": {"const": "open"}
      }
    },
    "case_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "route", "route_reason", "route_consumed_at", "route_consumer"],
      "properties": {
        "status": {"const": "investigating"},
        "route": {"enum": [null, "investigate_more"]},
        "route_reason": {"type": ["string", "null"]},
        "route_consumed_at": {"type": ["string", "null"]},
        "route_consumer": {"type": ["string", "null"]}
      },
      "oneOf": [
        {"properties": {"route": {"type": "null"}, "route_reason": {"type": "null"}, "route_consumed_at": {"type": "null"}, "route_consumer": {"type": "null"}}},
        {"properties": {"route": {"const": "investigate_more"}, "route_reason": {"type": "string", "minLength": 1}, "route_consumed_at": {"type": "null"}, "route_consumer": {"type": "null"}}}
      ]
    },
    "finding_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "ref", "sha256", "document"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^finding-[A-Za-z0-9._-]+$"},
        "ref": {"$ref": "#/$defs/relative_ref"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "document": {"$ref": "finding.schema.json"}
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "origin", "attestation", "invalidated_by"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 4096},
        "origin": {"enum": ["hypothesis", "finding"]},
        "source_finding_id": {"type": "string", "pattern": "^finding-[A-Za-z0-9._-]+$"},
        "attestation": {"enum": ["runtime_index", "execution_anchor", "finding_source", "file_source"]},
        "kind": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relative_ref"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "valid"},
        "baseline_generation": {"type": "integer", "minimum": 0},
        "review_round": {"type": "integer", "minimum": 1},
        "invalidated_by": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"const": "finding"}}, "required": ["origin"]},
          "then": {"required": ["source_finding_id"]},
          "else": {"not": {"required": ["source_finding_id"]}}
        },
        {
          "if": {"properties": {"attestation": {"const": "runtime_index"}}, "required": ["attestation"]},
          "then": {"required": ["kind", "path", "sha256", "status", "baseline_generation", "review_round"], "properties": {"invalidated_by": {"type": "null"}}}
        },
        {
          "if": {"properties": {"attestation": {"const": "finding_source"}}, "required": ["attestation"]},
          "then": {
            "properties": {"invalidated_by": {"type": "null"}},
            "not": {"anyOf": [{"required": ["kind"]}, {"required": ["status"]}, {"required": ["baseline_generation"]}, {"required": ["review_round"]}]},
            "dependentRequired": {"path": ["sha256"], "sha256": ["path"]}
          }
        },
        {
          "if": {"properties": {"attestation": {"const": "execution_anchor"}}, "required": ["attestation"]},
          "then": {
            "properties": {"ref": {"pattern": "^[A-Za-z][A-Za-z0-9+.-]*://"}, "invalidated_by": {"type": "null"}},
            "not": {"anyOf": [{"required": ["kind"]}, {"required": ["path"]}, {"required": ["sha256"]}, {"required": ["status"]}, {"required": ["baseline_generation"]}, {"required": ["review_round"]}]}
          }
        }
      ]
    },
    "expected_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "refute"],
      "properties": {"support": {"type": "string", "minLength": 1}, "refute": {"type": "string", "minLength": 1}}
    },
    "relative_ref": {"type": "string", "minLength": 1, "description": "A safe project-relative reference; the Go builder enforces path traversal and separator rules."},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
