{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/hypothesis-result-work-packet.schema.json",
  "title": "S8 HypothesisResult work packet",
  "description": "Neutral authoring projection only. Original InvestigationCase, Findings, registered Assignment and actual references provide the professional context.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_id",
    "template_id",
    "binding",
    "inputs",
    "result_id",
    "issuance_event_id",
    "view_path",
    "answer_path",
    "draft"
  ],
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^packet-[A-Za-z0-9_-]+$"
    },
    "template_id": {
      "const": "s8-hypothesis-result-v1"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "result_id": {
      "type": "string",
      "pattern": "^hypothesis-result-[A-Za-z0-9_-]+$"
    },
    "issuance_event_id": {
      "type": "string",
      "minLength": 1
    },
    "view_path": {
      "type": "string",
      "pattern": "^\\.claude/work-packets/"
    },
    "answer_path": {
      "type": "string",
      "pattern": "^\\.claude/submissions/"
    },
    "draft": {
      "$ref": "stage-answer-s8.schema.json"
    },
    "late_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer",
          "execution_root",
          "accepted_event_id",
          "accepted_idempotency_key",
          "accepted_after_runtime_revision",
          "accepted_sequence"
        ],
        "properties": {
          "answer": {
            "$ref": "stage-answer-s8.schema.json#/$defs/answer"
          },
          "execution_root": {
            "type": "string",
            "minLength": 1
          },
          "accepted_event_id": {
            "type": "string",
            "minLength": 1
          },
          "accepted_idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "accepted_after_runtime_revision": {
            "type": "integer",
            "minimum": 1
          },
          "accepted_sequence": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "runtime_id",
        "baseline_generation",
        "case_id",
        "case_ref",
        "case_revision",
        "source_finding_ids",
        "hypothesis_id",
        "hypothesis_source_finding_ids",
        "assignment_id",
        "team_id",
        "task_id",
        "task_ref",
        "manifest_ref",
        "owner_agent_id"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "baseline_generation": {
          "type": "integer",
          "minimum": 0
        },
        "case_id": {
          "type": "string",
          "pattern": "^investigation-case-[A-Za-z0-9._-]+$"
        },
        "case_ref": {
          "$ref": "#/$defs/relative_ref"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_finding_ids": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^finding-[A-Za-z0-9._-]+$"
          }
        },
        "hypothesis_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "hypothesis_source_finding_ids": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^finding-[A-Za-z0-9._-]+$"
          }
        },
        "assignment_id": {
          "type": "string",
          "pattern": "^assignment-[A-Za-z0-9._-]+$"
        },
        "team_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "task_ref": {
          "$ref": "#/$defs/relative_ref"
        },
        "manifest_ref": {
          "$ref": "#/$defs/relative_ref"
        },
        "owner_agent_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "case_route",
        "findings",
        "evidence_refs"
      ],
      "properties": {
        "hypothesis": {
          "$ref": "#/$defs/hypothesis"
        },
        "case_route": {
          "$ref": "#/$defs/case_route"
        },
        "findings": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/finding_source"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "assignment_id",
        "statement",
        "invariant",
        "discriminator",
        "expected_outcomes",
        "source_finding_ids",
        "evidence_refs",
        "status"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1
        },
        "assignment_id": {
          "type": "string",
          "pattern": "^assignment-[A-Za-z0-9._-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "discriminator": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcomes": {
          "$ref": "#/$defs/expected_outcomes"
        },
        "source_finding_ids": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^finding-[A-Za-z0-9._-]+$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "const": "open"
        }
      }
    },
    "case_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "route",
        "route_reason",
        "route_consumed_at",
        "route_consumer"
      ],
      "properties": {
        "status": {
          "const": "investigating"
        },
        "route": {
          "enum": [
            null,
            "investigate_more"
          ]
        },
        "route_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_consumed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "route_consumer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "route": {
              "type": "null"
            },
            "route_reason": {
              "type": "null"
            },
            "route_consumed_at": {
              "type": "null"
            },
            "route_consumer": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "route": {
              "const": "investigate_more"
            },
            "route_reason": {
              "type": "string",
              "minLength": 1
            },
            "route_consumed_at": {
              "type": "null"
            },
            "route_consumer": {
              "type": "null"
            }
          }
        }
      ]
    },
    "finding_source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "finding_id",
        "ref",
        "document"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^finding-[A-Za-z0-9._-]+$"
        },
        "ref": {
          "$ref": "#/$defs/relative_ref"
        },
        "document": {
          "$ref": "finding.schema.json"
        }
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "ref",
        "origin",
        "attestation",
        "invalidated_by"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin": {
          "enum": [
            "hypothesis",
            "finding"
          ]
        },
        "source_finding_id": {
          "type": "string",
          "pattern": "^finding-[A-Za-z0-9._-]+$"
        },
        "attestation": {
          "enum": [
            "runtime_index",
            "execution_anchor",
            "finding_source",
            "file_source",
            "reference"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relative_ref"
        },
        "status": {
          "const": "valid"
        },
        "baseline_generation": {
          "type": "integer",
          "minimum": 0
        },
        "invalidated_by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "expected_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support",
        "refute"
      ],
      "properties": {
        "support": {
          "type": "string",
          "minLength": 1
        },
        "refute": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relative_ref": {
      "type": "string",
      "minLength": 1,
      "description": "A safe project-relative reference; the Go builder enforces path traversal and separator rules."
    }
  }
}
