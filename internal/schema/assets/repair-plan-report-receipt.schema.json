{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/repair-plan-report-receipt.schema.json",
  "title": "Original S9 PlanReport packet receipt",
  "description": "Stored in the original immutable PlanReport. Its own SHA is derived from the original Runtime pointer, so the receipt intentionally has no self-hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "packet_id", "packet_sha256", "answer_sha256", "submitted_answer",
    "owner_agent_id", "runtime_id", "baseline_generation", "review_round",
    "case_id", "case_ref", "case_sha256", "contract_id", "contract_ref", "contract_sha256",
    "session_id", "session_ref", "session_sha256", "plan_id", "plan_ref", "plan_sha256",
    "repair_assignment_id", "repair_assignment_sha256", "manifest_assignment_id",
    "manifest_assignment_sha256", "team_id", "task_id", "task_ref", "task_sha256",
    "manifest_ref", "manifest_sha256", "execution_root", "report_id", "report_ref",
    "work_complete", "issuance_event_id", "accepted_event_id", "accepted_idempotency_key",
    "accepted_after_runtime_revision", "accepted_sequence"
  ],
  "properties": {
    "contract": {"const": "s9-plan-report-receipt-v1"},
    "packet_id": {"type": "string", "pattern": "^packet-[a-f0-9]{64}$"},
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "answer_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "submitted_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "red_checks", "proposed_paths"],
      "properties": {
        "plan": {"type": "string", "minLength": 1},
        "red_checks": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "command", "result", "evidence_refs"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "command": {"type": "string", "minLength": 1},
              "result": {"enum": ["fail", "pass", "blocked"]},
              "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "proposed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "owner_agent_id": {"type": "string", "minLength": 1},
    "runtime_id": {"type": "string", "minLength": 1},
    "baseline_generation": {"type": "integer", "minimum": 1},
    "review_round": {"type": "integer", "minimum": 1},
    "case_id": {"type": "string", "pattern": "^investigation-case-[A-Za-z0-9._-]+$"},
    "case_ref": {"type": "string", "minLength": 1},
    "case_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_id": {"type": "string", "pattern": "^repair-contract-[A-Za-z0-9._-]+$"},
    "contract_ref": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "session_id": {"type": "string", "pattern": "^repair-session-[A-Za-z0-9._-]+$"},
    "session_ref": {"type": "string", "minLength": 1},
    "session_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_id": {"type": "string", "pattern": "^repair-plan-[A-Za-z0-9._-]+$"},
    "plan_ref": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repair_assignment_id": {"type": "string", "pattern": "^repair-assignment-[A-Za-z0-9._-]+$"},
    "repair_assignment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_assignment_id": {"type": "string", "pattern": "^assignment-[A-Za-z0-9._-]+$"},
    "manifest_assignment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "team_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9._-]+$"},
    "task_ref": {"type": "string", "minLength": 1},
    "task_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_ref": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_root": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "pattern": "^repair-plan-report-[A-Za-z0-9._-]+$"},
    "report_ref": {"type": "string", "pattern": "^\\.claude/review/repair/plan-reports/repair-plan-report-[A-Za-z0-9._-]+\\.json$"},
    "work_complete": {"const": false},
    "issuance_event_id": {"type": "string", "minLength": 1},
    "accepted_event_id": {"type": "string", "minLength": 1},
    "accepted_idempotency_key": {"type": "string", "minLength": 1},
    "accepted_after_runtime_revision": {"type": "integer", "minimum": 1},
    "accepted_sequence": {"type": "integer", "minimum": 1}
  }
}
