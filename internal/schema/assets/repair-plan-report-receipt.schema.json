{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/repair-plan-report-receipt.schema.json",
  "title": "Original S9 PlanReport packet receipt",
  "description": "Stored in the original PlanReport and linked by the registered Runtime responsibility.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract",
    "packet_id",
    "submitted_answer",
    "owner_agent_id",
    "runtime_id",
    "baseline_generation",
    "case_id",
    "case_ref",
    "contract_id",
    "contract_ref",
    "session_id",
    "session_ref",
    "plan_id",
    "plan_ref",
    "repair_assignment_id",
    "manifest_assignment_id",
    "team_id",
    "task_id",
    "task_ref",
    "manifest_ref",
    "execution_root",
    "report_id",
    "report_ref",
    "work_complete",
    "issuance_event_id",
    "accepted_event_id",
    "accepted_idempotency_key",
    "accepted_after_runtime_revision",
    "accepted_sequence"
  ],
  "properties": {
    "contract": {
      "const": "s9-plan-report-receipt-v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^packet-[A-Za-z0-9_-]+$"
    },
    "submitted_answer": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "plan"
      ],
      "properties": {
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "red_checks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "evidence_refs": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "proposed_paths": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "owner_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_generation": {
      "type": "integer",
      "minimum": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^investigation-case-[A-Za-z0-9._-]+$"
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "pattern": "^repair-contract-[A-Za-z0-9._-]+$"
    },
    "contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^repair-session-[A-Za-z0-9._-]+$"
    },
    "session_ref": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^repair-plan-[A-Za-z0-9._-]+$"
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "repair_assignment_id": {
      "type": "string",
      "pattern": "^repair-assignment-[A-Za-z0-9._-]+$"
    },
    "manifest_assignment_id": {
      "type": "string",
      "pattern": "^assignment-[A-Za-z0-9._-]+$"
    },
    "team_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9._-]+$"
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "execution_root": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "pattern": "^repair-plan-report-[A-Za-z0-9._-]+$"
    },
    "report_ref": {
      "type": "string",
      "minLength": 1
    },
    "work_complete": {
      "const": false
    },
    "issuance_event_id": {
      "type": "string",
      "minLength": 1
    },
    "accepted_event_id": {
      "type": "string",
      "minLength": 1
    },
    "accepted_idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "accepted_after_runtime_revision": {
      "type": "integer",
      "minimum": 1
    },
    "accepted_sequence": {
      "type": "integer",
      "minimum": 1
    }
  }
}
