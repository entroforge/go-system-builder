{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "runtime_id",
    "assignment_id",
    "session_id",
    "plan_id",
    "version",
    "execution_generation",
    "baseline_generation",
    "proposal"
  ],
  "properties": {
    "record_type": {
      "const": "repair_workspace_candidate"
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "execution_generation": {
      "type": "integer",
      "minimum": 1
    },
    "baseline_generation": {
      "type": "integer",
      "minimum": 0
    },
    "proposal": {
      "type": "object"
    },
    "provenance": {
      "$ref": "repair-result-candidate-provenance.schema.json"
    }
  }
}
