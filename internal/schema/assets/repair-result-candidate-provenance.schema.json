{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/repair-result-candidate-provenance.schema.json",
  "title": "Original S9 RepairResult candidate provenance",
  "description": "Binds a professional answer to its issued packet and execution. It is not a delivery receipt and carries no self hash or predicted Runtime sequence.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract",
    "packet_id",
    "issuance_event_id",
    "submitted_answer",
    "owner_agent_id",
    "runtime_id",
    "baseline_generation",
    "execution_assignment_id",
    "execution_generation",
    "execution_root",
    "plan_report_ref",
    "rework_ref",
    "worker_check_receipts",
    "owned_check_receipts"
  ],
  "properties": {
    "private_submissions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "enum": [
              "plan",
              "result"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^\\.loop-submissions/native-s9/packet-[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/(plan|result)\\.json$"
          }
        }
      }
    },
    "local_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "authored_ref",
          "source_path",
          "path"
        ],
        "properties": {
          "authored_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^\\.claude/evidence(-alt-[1-9][0-9]*)?/s9/"
          }
        }
      }
    },
    "contract": {
      "const": "s9-repair-result-candidate-v1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^packet-[A-Za-z0-9._-]+$"
    },
    "issuance_event_id": {
      "type": "string",
      "pattern": "^evt-repair-result-packet-packet-[A-Za-z0-9._-]+$"
    },
    "submitted_answer": {
      "$ref": "stage-answer-s9-result.schema.json#/$defs/answer"
    },
    "owner_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_generation": {
      "type": "integer",
      "minimum": 1
    },
    "execution_assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_generation": {
      "type": "integer",
      "minimum": 1
    },
    "execution_root": {
      "type": "string",
      "minLength": 1
    },
    "plan_report_ref": {
      "type": "string",
      "minLength": 1
    },
    "rework_ref": {
      "type": "string"
    },
    "resume": {
      "$ref": "repair-result-work-packet.schema.json#/$defs/resume"
    },
    "worker_check_receipts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/tool_receipt"
      }
    },
    "owned_check_receipts": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "worker_check_index",
          "receipt"
        ],
        "properties": {
          "worker_check_index": {
            "type": "integer",
            "minimum": 0
          },
          "receipt": {
            "$ref": "#/$defs/tool_receipt"
          }
        }
      }
    }
  },
  "$defs": {
    "tool_receipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path",
        "checkout",
        "command",
        "binding"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "checkout": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "runtime_id",
            "baseline_generation",
            "assignment_id",
            "owner",
            "execution_generation",
            "responsibility"
          ],
          "properties": {
            "runtime_id": {
              "type": "string",
              "minLength": 1
            },
            "baseline_generation": {
              "type": "integer",
              "minimum": 1
            },
            "assignment_id": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "execution_generation": {
              "type": "integer",
              "minimum": 1
            },
            "responsibility": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
