{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/scenario-model.schema.json",
  "title": "Module Scenario Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "coverage_profile",
    "facts",
    "rules"
  ],
  "properties": {
    "module": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "coverage_profile": {
      "enum": [
        "ordinary",
        "rule-dense",
        "critical"
      ]
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "positiveOracleRequirements": {
      "type": "object",
      "required": [
        "visible",
        "terminal_state",
        "persisted_effects",
        "forbidden_side_effects"
      ],
      "properties": {
        "visible": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "terminal_state": {
          "type": "string",
          "minLength": 1
        },
        "persisted_effects": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "forbidden_side_effects": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    },
    "negativeOracleRequirements": {
      "type": "object",
      "required": [
        "visible",
        "terminal_state",
        "persisted_effects",
        "forbidden_side_effects",
        "rejection",
        "expected_state",
        "recovery"
      ],
      "properties": {
        "visible": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "terminal_state": {
          "type": "string",
          "minLength": 1
        },
        "persisted_effects": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "forbidden_side_effects": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "rejection": {
          "type": "string",
          "minLength": 1
        },
        "expected_state": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        },
        "recovery_source_refs": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "recovery_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "recovery"
            ],
            "properties": {
              "recovery": {
                "type": "string",
                "pattern": "^\\s*[nN]/[aA]\\s*$"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "recovery_source_refs",
              "recovery_reason"
            ],
            "properties": {
              "recovery_source_refs": {
                "$ref": "#/$defs/nonEmptyStrings"
              },
              "recovery_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "partitions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "partitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/partition"
          }
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "risk",
        "branches"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "title",
        "polarity",
        "required",
        "witness",
        "oracle",
        "fixture_id",
        "story_refs",
        "flow_refs",
        "browser_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^CASE-[A-Z0-9]+(-[A-Z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "witness": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "story_refs": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "flow_refs": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "browser_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "polarity": {
                "const": "positive"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "oracle": {
                "$ref": "#/$defs/positiveOracleRequirements"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "polarity": {
                "const": "negative"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "oracle": {
                "$ref": "#/$defs/negativeOracleRequirements"
              }
            }
          }
        }
      ]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "terminal_state": {
          "type": "string",
          "minLength": 1
        },
        "persisted_effects": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "forbidden_side_effects": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "rejection": {
          "type": "string",
          "minLength": 1
        },
        "expected_state": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        },
        "recovery_source_refs": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "recovery_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
