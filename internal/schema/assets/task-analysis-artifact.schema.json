{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-analysis-artifact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser_version",
    "inputs",
    "task_contexts",
    "granularity_advice"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "parser_version": {
      "const": "1.0.0"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "version",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "task_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "task_ref",
          "reading",
          "bytes_by_mode",
          "total_unique_bytes",
          "writes",
          "modules",
          "dependencies",
          "clauses",
          "check_entrances",
          "unresolved_assertions"
        ],
        "properties": {
          "writes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "clauses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unresolved_assertions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task_id": {
            "type": "string"
          },
          "task_ref": {
            "type": "string"
          },
          "reading": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "mode",
                "condition_unknown",
                "status",
                "bytes"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "anchor": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "clauses": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "selection": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "condition_unknown": {
                  "type": "boolean"
                },
                "bytes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          },
          "bytes_by_mode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "conditional",
              "optional",
              "legacy_unspecified"
            ],
            "properties": {
              "required": {
                "type": "integer",
                "minimum": 0
              },
              "conditional": {
                "type": "integer",
                "minimum": 0
              },
              "optional": {
                "type": "integer",
                "minimum": 0
              },
              "legacy_unspecified": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "total_unique_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "check_entrances": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command",
                "source"
              ],
              "properties": {
                "command": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "granularity_advice": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "task_ids",
          "source_refs",
          "paths",
          "observation",
          "question"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "structural_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "cancelled",
        "clauses_total",
        "clauses_covered",
        "problems"
      ],
      "properties": {
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0
        },
        "clauses_total": {
          "type": "integer",
          "minimum": 0
        },
        "clauses_covered": {
          "type": "integer",
          "minimum": 0
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "behavior_projection_version": {
      "const": "1.0.0"
    },
    "behavior_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "task_ref",
          "source",
          "status",
          "condition_unknown"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_ref": {
            "type": "string"
          },
          "case_ref": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "status": {
            "enum": [
              "unresolved",
              "source_example"
            ]
          },
          "example": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case",
              "inputs",
              "fixture",
              "sources"
            ],
            "properties": {
              "case": {
                "$ref": "#/$defs/case"
              },
              "inputs": {
                "type": "object",
                "minProperties": 1
              },
              "fixture": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "persona",
                  "synthetic",
                  "setup",
                  "cleanup"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "persona": {
                    "type": "string",
                    "minLength": 1
                  },
                  "synthetic": {
                    "const": true
                  },
                  "setup": {
                    "$ref": "#/$defs/steps"
                  },
                  "cleanup": {
                    "$ref": "#/$defs/steps"
                  }
                }
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/behaviorSource"
                }
              }
            }
          },
          "mode": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "condition_unknown": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "source_example"
                }
              }
            },
            "then": {
              "required": [
                "example",
                "case_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unresolved"
                }
              }
            },
            "then": {
              "required": [
                "question"
              ],
              "not": {
                "required": [
                  "example"
                ]
              }
            }
          }
        ]
      }
    },
    "conventions_resolver_version": {
      "const": "1.0.0"
    },
    "task_conventions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/convention_projection"
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "positiveOracleRequirements": {
      "type": "object",
      "required": [
        "visible",
        "terminal_state",
        "persisted_effects",
        "forbidden_side_effects"
      ],
      "properties": {
        "visible": {
          "$ref": "#/$defs/strings"
        },
        "terminal_state": {
          "type": "string",
          "minLength": 1
        },
        "persisted_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_side_effects": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "negativeOracleRequirements": {
      "type": "object",
      "required": [
        "visible",
        "terminal_state",
        "persisted_effects",
        "forbidden_side_effects",
        "rejection",
        "expected_state",
        "recovery"
      ],
      "properties": {
        "visible": {
          "$ref": "#/$defs/strings"
        },
        "terminal_state": {
          "type": "string",
          "minLength": 1
        },
        "persisted_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_side_effects": {
          "$ref": "#/$defs/strings"
        },
        "rejection": {
          "type": "string",
          "minLength": 1
        },
        "expected_state": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        },
        "recovery_source_refs": {
          "$ref": "#/$defs/strings"
        },
        "recovery_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "recovery"
            ],
            "properties": {
              "recovery": {
                "type": "string",
                "pattern": "^\\s*[nN]/[aA]\\s*$"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "recovery_source_refs",
              "recovery_reason"
            ],
            "properties": {
              "recovery_source_refs": {
                "$ref": "#/$defs/strings"
              },
              "recovery_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {
          "$ref": "#/$defs/strings"
        },
        "terminal_state": {
          "type": "string",
          "minLength": 1
        },
        "persisted_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_side_effects": {
          "$ref": "#/$defs/strings"
        },
        "rejection": {
          "type": "string",
          "minLength": 1
        },
        "expected_state": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "minLength": 1
        },
        "recovery_source_refs": {
          "$ref": "#/$defs/strings"
        },
        "recovery_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "branch_id",
        "title",
        "polarity",
        "required",
        "witness",
        "oracle",
        "fixture_id",
        "story_refs",
        "flow_refs",
        "browser_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "branch_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "witness": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "story_refs": {
          "$ref": "#/$defs/strings"
        },
        "flow_refs": {
          "$ref": "#/$defs/strings"
        },
        "browser_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "polarity": {
                "const": "positive"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "oracle": {
                "$ref": "#/$defs/positiveOracleRequirements"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "polarity": {
                "const": "negative"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "oracle": {
                "$ref": "#/$defs/negativeOracleRequirements"
              }
            }
          }
        }
      ]
    },
    "behaviorSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "persona",
        "synthetic",
        "setup",
        "cleanup"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "const": true
        },
        "setup": {
          "$ref": "#/$defs/steps"
        },
        "cleanup": {
          "$ref": "#/$defs/steps"
        }
      }
    },
    "convention_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "architecture",
            "decision"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00]+$"
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "architecture",
                  "decision"
                ]
              }
            }
          },
          "then": {
            "required": [
              "version"
            ]
          }
        }
      ]
    },
    "convention_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "convention_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "scope",
        "default",
        "source_refs",
        "example_refs",
        "exceptions",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\:\\x00]+$"
          }
        },
        "default": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/convention_reference"
          }
        },
        "example_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/convention_example"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "candidate",
            "approved",
            "migration",
            "superseded"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "convention_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolver_version",
        "task_id",
        "task_ref",
        "registry_status",
        "sources",
        "entries",
        "questions"
      ],
      "properties": {
        "resolver_version": {
          "const": "1.0.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "registry_status": {
          "enum": [
            "absent",
            "present",
            "invalid",
            "unreadable",
            "parse_limit_exceeded"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "source_mode",
              "status"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_mode": {
                "enum": [
                  "disk",
                  "git_tree",
                  "unresolved"
                ]
              },
              "status": {
                "enum": [
                  "readable",
                  "unreadable",
                  "absent",
                  "parse_limit_exceeded"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "readable"
                    }
                  }
                },
                "then": {
                  "required": [
                    "sha256"
                  ]
                }
              }
            ]
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry",
              "status",
              "questions"
            ],
            "properties": {
              "entry": {
                "$ref": "#/$defs/convention_entry"
              },
              "status": {
                "enum": [
                  "candidate",
                  "declared_default",
                  "conflict",
                  "stale",
                  "migration",
                  "superseded"
                ]
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "dependentRequired": {
    "behavior_examples": [
      "behavior_projection_version"
    ],
    "behavior_projection_version": [
      "behavior_examples"
    ],
    "conventions_resolver_version": [
      "task_conventions"
    ],
    "task_conventions": [
      "conventions_resolver_version"
    ]
  }
}
