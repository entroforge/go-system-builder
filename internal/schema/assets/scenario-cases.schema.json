{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/scenario-cases.schema.json",
  "title": "Generated Module Scenario Cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["module", "cases"],
  "properties": {
    "module": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "positiveOracleRequirements": {
      "type": "object",
      "required": ["visible", "terminal_state", "persisted_effects", "forbidden_side_effects"],
      "properties": {
        "visible": {"$ref": "#/$defs/strings"},
        "terminal_state": {"type": "string", "minLength": 1},
        "persisted_effects": {"$ref": "#/$defs/strings"},
        "forbidden_side_effects": {"$ref": "#/$defs/strings"}
      }
    },
    "negativeOracleRequirements": {
      "type": "object",
      "required": ["visible", "terminal_state", "persisted_effects", "forbidden_side_effects", "rejection", "expected_state", "recovery"],
      "properties": {
        "visible": {"$ref": "#/$defs/strings"},
        "terminal_state": {"type": "string", "minLength": 1},
        "persisted_effects": {"$ref": "#/$defs/strings"},
        "forbidden_side_effects": {"$ref": "#/$defs/strings"},
        "rejection": {"type": "string", "minLength": 1},
        "expected_state": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "recovery_source_refs": {"$ref": "#/$defs/strings"},
        "recovery_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["recovery"],
            "properties": {"recovery": {"type": "string", "pattern": "^\\s*[nN]/[aA]\\s*$"}}
          },
          "then": {
            "type": "object",
            "required": ["recovery_source_refs", "recovery_reason"],
            "properties": {
              "recovery_source_refs": {"$ref": "#/$defs/strings"},
              "recovery_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "visible": {"$ref": "#/$defs/strings"},
        "terminal_state": {"type": "string", "minLength": 1},
        "persisted_effects": {"$ref": "#/$defs/strings"},
        "forbidden_side_effects": {"$ref": "#/$defs/strings"},
        "rejection": {"type": "string", "minLength": 1},
        "expected_state": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "recovery_source_refs": {"$ref": "#/$defs/strings"},
        "recovery_reason": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule_id", "branch_id", "title", "polarity", "required", "witness", "oracle", "fixture_id", "story_refs", "flow_refs", "browser_required"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "branch_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "polarity": {"enum": ["positive", "negative"]},
        "required": {"type": "boolean"},
        "witness": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "oracle": {"$ref": "#/$defs/oracle"},
        "fixture_id": {"type": "string", "minLength": 1},
        "story_refs": {"$ref": "#/$defs/strings"},
        "flow_refs": {"$ref": "#/$defs/strings"},
        "browser_required": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"type": "object", "properties": {"polarity": {"const": "positive"}}}, "then": {"type": "object", "properties": {"oracle": {"$ref": "#/$defs/positiveOracleRequirements"}}}},
        {"if": {"type": "object", "properties": {"polarity": {"const": "negative"}}}, "then": {"type": "object", "properties": {"oracle": {"$ref": "#/$defs/negativeOracleRequirements"}}}}
      ]
    }
  }
}
