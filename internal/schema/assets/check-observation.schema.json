{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "check-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "profile_version",
    "environment",
    "verification_scope",
    "reuse_eligible"
  ],
  "properties": {
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "verification_scope": {
      "type": "string",
      "minLength": 1
    },
    "reuse_eligible": {
      "type": "boolean"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "runner",
        "platform",
        "kernel",
        "main_root",
        "common_dir",
        "worker_root",
        "cwd",
        "uid",
        "gid",
        "groups",
        "available"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "runner": {
          "const": "worker_bubblewrap_seccomp_v1"
        },
        "platform": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "main_root": {
          "type": "string"
        },
        "common_dir": {
          "type": "string"
        },
        "worker_root": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "uid": {
          "type": "integer"
        },
        "gid": {
          "type": "integer"
        },
        "groups": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          }
        },
        "available": {
          "type": "boolean"
        },
        "diagnostic": {
          "type": "string"
        }
      }
    }
  }
}
