{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/s10-audit-manifest.schema.json",
  "title": "S10 Acceptance and Release Audit Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_type", "runtime_id", "baseline_generation",
    "review_round", "coverage_inventory", "counterevidence", "risks",
    "technical_debt", "blocking_findings", "metrics"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_type": {"enum": ["acceptance", "release_audit"]},
    "runtime_id": {"type": "string", "minLength": 1},
    "baseline_generation": {"type": "integer", "minimum": 1},
    "review_round": {"type": "integer", "minimum": 1},
    "coverage_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coverageItem"}
    },
    "counterevidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/counterevidenceItem"}
    },
    "audit_areas": {
      "type": "array",
      "items": {"$ref": "#/$defs/auditArea"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/riskItem"}
    },
    "technical_debt": {
      "type": "array",
      "items": {"$ref": "#/$defs/debtItem"}
    },
    "blocking_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/blockingFinding"}
    },
    "metrics": {"$ref": "#/$defs/metrics"}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "coverageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "source_refs", "expected", "oracle", "owner", "evidence_refs", "disposition"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/strings"},
        "expected": {"type": "string", "minLength": 1},
        "oracle": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "disposition": {"enum": ["pass", "not_applicable", "unknown", "fail"]},
        "na_reason": {"type": "string"}
      }
    },
    "counterevidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inventory_id", "question", "evidence_refs", "outcome"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "inventory_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "outcome": {"enum": ["pass", "not_applicable", "unknown", "fail"]}
      }
    },
    "auditArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "conclusion", "owner", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "conclusion": {"enum": ["pass", "not_applicable"]},
        "owner": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "riskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "impact", "owner", "tracking_ref", "recovery_point"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "impact": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "tracking_ref": {"type": "string", "minLength": 1},
        "recovery_point": {"type": "string", "minLength": 1}
      }
    },
    "debtItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "impact", "owner", "tracking_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "tracking_ref": {"type": "string", "minLength": 1}
      }
    },
    "blockingFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_coverage", "contract_coverage", "changed_path_coverage",
        "unknown_count", "unsupported_pass_count",
        "unowned_risk_count", "untracked_debt_count", "blocking_finding_count"
      ],
      "properties": {
        "requirement_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "contract_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "changed_path_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "audit_area_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "unknown_count": {"type": "integer", "minimum": 0},
        "unsupported_pass_count": {"type": "integer", "minimum": 0},
        "unowned_risk_count": {"type": "integer", "minimum": 0},
        "untracked_debt_count": {"type": "integer", "minimum": 0},
        "blocking_finding_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest_type": {"const": "release_audit"}
        },
        "required": ["manifest_type"]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": ["audit_area_coverage"]
          }
        }
      }
    }
  ]
}
