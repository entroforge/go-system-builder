{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/s10-audit-manifest.schema.json",
  "title": "S10 Acceptance and Release Audit Manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "manifest_type": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "runtime_id": {
      "type": "string"
    },
    "baseline_generation": {
      "type": "integer"
    },
    "review_round": {
      "type": "integer"
    },
    "coverage_inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverageItem"
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/counterevidenceItem"
      }
    },
    "audit_areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auditArea"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/riskItem"
      }
    },
    "technical_debt": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/debtItem"
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blockingFinding"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverageItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "source_refs": {
          "$ref": "#/$defs/strings"
        },
        "expected": {
          "description": "System-prefilled original source commitment; preserve the supplied baseline. Author judgments belong in disposition and oracle.",
          "type": "string"
        },
        "oracle": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/strings"
        },
        "disposition": {
          "type": "string"
        },
        "na_reason": {
          "type": "string"
        }
      }
    },
    "counterevidenceItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "inventory_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/strings"
        },
        "outcome": {
          "type": "string"
        }
      }
    },
    "auditArea": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "evidence_refs": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "riskItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "tracking_ref": {
          "type": "string"
        },
        "recovery_point": {
          "type": "string"
        }
      }
    },
    "debtItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "tracking_ref": {
          "type": "string"
        }
      }
    },
    "blockingFinding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "route": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "requirement_coverage": {
          "type": "number"
        },
        "contract_coverage": {
          "type": "number"
        },
        "changed_path_coverage": {
          "type": "number"
        },
        "audit_area_coverage": {
          "type": "number"
        },
        "unknown_count": {
          "type": "integer"
        },
        "unsupported_pass_count": {
          "type": "integer"
        },
        "unowned_risk_count": {
          "type": "integer"
        },
        "untracked_debt_count": {
          "type": "integer"
        },
        "blocking_finding_count": {
          "type": "integer"
        }
      }
    }
  }
}
