{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/repair-result-receipt.schema.json",
  "title": "Original accepted S9 RepairResult receipt",
  "description": "Stored in the original immutable RepairResult and bound by the original Runtime result ref. No self hash is included.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract",
    "provenance",
    "candidate_ref",
    "result_id",
    "result_ref",
    "main_proof",
    "work_complete",
    "accepted_event_id",
    "accepted_idempotency_key",
    "accepted_after_runtime_revision",
    "accepted_sequence"
  ],
  "properties": {
    "contract": {
      "const": "s9-repair-result-receipt-v1"
    },
    "provenance": {
      "$ref": "repair-result-candidate-provenance.schema.json"
    },
    "candidate_ref": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "pattern": "^repair-result-[A-Za-z0-9_-]+$"
    },
    "result_ref": {
      "type": "string",
      "minLength": 1
    },
    "main_proof": {
      "$ref": "#/$defs/main_proof"
    },
    "work_complete": {
      "const": true
    },
    "accepted_event_id": {
      "type": "string",
      "pattern": "^evt-s9-issued-repair-result-packet-[A-Za-z0-9_-]+$"
    },
    "accepted_idempotency_key": {
      "type": "string",
      "pattern": "^runtime:s9:issued-repair-result:packet-[A-Za-z0-9_-]+$"
    },
    "accepted_after_runtime_revision": {
      "type": "integer",
      "minimum": 1
    },
    "accepted_sequence": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "main_proof": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "checkpoint_ref",
        "verified_facts"
      ],
      "properties": {
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "verified_facts": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "assignment_id"
          ],
          "properties": {
            "assignment_id": {
              "type": "string",
              "minLength": 1
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "baseline_generation": {
              "type": "integer",
              "minimum": 1
            },
            "assignment_record": {
              "type": [
                "object",
                "null"
              ]
            },
            "source_branch": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "target_branch": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "worktree_path": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "changed_paths": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "canonical_main_facts": {
              "type": [
                "object",
                "null"
              ]
            },
            "completion_report_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified_at": {
              "type": "string",
              "minLength": 1
            },
            "idempotency_key": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "check_receipts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tool_check_receipts": {
              "type": "array",
              "items": {
                "$ref": "repair-result-candidate-provenance.schema.json#/$defs/tool_receipt"
              }
            }
          }
        }
      }
    }
  }
}
