{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-conventions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resolver_version",
    "task_id",
    "task_ref",
    "registry_status",
    "sources",
    "entries",
    "questions"
  ],
  "properties": {
    "resolver_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "registry_status": {
      "enum": [
        "absent",
        "present",
        "invalid",
        "unreadable",
        "parse_limit_exceeded"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_mode",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_mode": {
            "enum": [
              "disk",
              "git_tree",
              "unresolved"
            ]
          },
          "status": {
            "enum": [
              "readable",
              "unreadable",
              "absent",
              "parse_limit_exceeded"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "readable"
                }
              }
            },
            "then": {
              "required": [
                "sha256"
              ]
            }
          }
        ]
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry",
          "status",
          "questions"
        ],
        "properties": {
          "entry": {
            "$ref": "#/$defs/entry"
          },
          "status": {
            "enum": [
              "candidate",
              "declared_default",
              "conflict",
              "stale",
              "migration",
              "superseded"
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "architecture",
            "decision"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00]+$"
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "architecture",
                  "decision"
                ]
              }
            }
          },
          "then": {
            "required": [
              "version"
            ]
          }
        }
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "scope",
        "default",
        "source_refs",
        "example_refs",
        "exceptions",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\:\\x00]+$"
          }
        },
        "default": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "example_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "candidate",
            "approved",
            "migration",
            "superseded"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
