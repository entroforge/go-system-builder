{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/review-result-packet-index.schema.json",
  "title": "S7 ReviewResult immutable packet body index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "template_id",
    "binding",
    "result_id",
    "issuance_event_id",
    "view_path",
    "answer_path",
    "storage_format",
    "body_ref"
  ],
  "properties": {
    "review_result_reception": {
      "$ref": "review-result-reception.schema.json"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "template_id": {
      "const": "s7-review-result-v1"
    },
    "template_sha256": {},
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "result_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "issuance_event_id": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "view_path": {
      "type": "string",
      "pattern": "^\\.claude/work-packets/[^\\\\:]+\\.json$"
    },
    "answer_path": {
      "type": "string",
      "pattern": "^(\\.claude/submissions/[^\\\\:]+|\\.loop-submissions/s7/[^\\\\:]+)/answer\\.json$"
    },
    "storage_format": {
      "const": "packet-body-ref-v1"
    },
    "body_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path"
      ],
      "properties": {
        "format": {
          "const": "packet-json-v1"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.claude/packet-bodies(-alt-[1-9][0-9]*)?/([0-9a-f]{64}\\.json|(p|alternate-[0-9]+)/([A-Za-z0-9_-]{1,120}/)*[A-Za-z0-9_-]{1,120}\\.json)$"
        },
        "sha256": {},
        "size_bytes": {}
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "baseline_generation",
        "review_plan_id",
        "review_plan_ref",
        "review_plan_revision",
        "assignment_id",
        "owner_agent_id",
        "claim_ids"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "baseline_generation": {
          "type": "integer",
          "minimum": 0
        },
        "review_plan_id": {
          "type": "string",
          "pattern": "^review-plan-[A-Za-z0-9._-]+$"
        },
        "review_plan_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "review_plan_sha256": {},
        "review_plan_revision": {
          "type": "integer",
          "minimum": 1
        },
        "review_round": {},
        "assignment_id": {
          "type": "string",
          "pattern": "^assignment-[A-Za-z0-9._-]+$"
        },
        "assignment_sha256": {},
        "owner_agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^claim-[A-Za-z0-9._-]+$"
          }
        },
        "subject_digest": {},
        "verification_artifact_digest": {}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "frozen_subjects"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "purpose"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(\\.claude/)?skills/[A-Za-z0-9][A-Za-z0-9._-]*/SKILL\\.md$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "method_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_ref"
          ],
          "properties": {
            "manifest_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "pattern": "^claim-[A-Za-z0-9._-]+$"
              },
              "lens": {
                "enum": [
                  null,
                  "",
                  "delivery",
                  "qa",
                  "e2e"
                ]
              },
              "target": {
                "type": "string"
              },
              "assertion": {
                "type": "string"
              },
              "oracle": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "required_evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "applicability": {
                "enum": [
                  null,
                  "",
                  "required",
                  "not_applicable"
                ]
              },
              "na_rationale": {
                "type": "string"
              },
              "na_checklist_id": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "focus_key": {
                "type": "string"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resource_locks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "frozen_subjects": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 16384,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "kind": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
