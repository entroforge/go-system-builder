{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/review-plan.schema.json",
  "title": "S7 Review Plan",
  "description": "S7 ReviewPlan with original review responsibilities and professional claims. The original Plan identity and path support its accepted results; no digest or Git object qualifies registration.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "review_plan_id",
    "baseline_generation",
    "claims",
    "assignments",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "review_plan_id": {
      "type": "string",
      "pattern": "^review-plan-[A-Za-z0-9._-]+$"
    },
    "baseline_generation": {
      "type": "integer",
      "minimum": 0
    },
    "frozen_subjects": {
      "type": [
        "array",
        "null"
      ],
      "description": "Existing frozen references when available; an empty list does not prevent a professional review.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          }
        }
      }
    },
    "coverage_inventory": {
      "type": "array",
      "description": "Optional professional coverage inventory and source references.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source_ref",
          "target",
          "lens"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "lens": {
            "enum": [
              "delivery",
              "qa",
              "e2e"
            ]
          }
        }
      }
    },
    "e2e_assets": {
      "type": "array",
      "description": "Available CASE/PATH assets selected by Main when known. Legacy machine metadata is not a reception requirement.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "case_ref",
          "path"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "case_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Exact docs/design/prototypes/<module>/cases.json#CASE reference. Historical bare CASE IDs remain readable; reception does not resolve or reread scenario sources."
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "selector_ref": {
            "type": "string"
          },
          "route_ref": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        }
      }
    },
    "change_impact": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Evidence or surface references used by the Planner; changed paths may be reviewed without a frozen digest."
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "description": "The single required Claim set. Static/E2E/discovery are computed views over this set, not separate authorities (L3-S7 v0.7.0).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^claim-[A-Za-z0-9._-]+$"
          },
          "lens": {
            "enum": [
              null,
              "",
              "delivery",
              "qa",
              "e2e"
            ]
          },
          "target": {
            "type": "string",
            "description": "Exact module, path, contract clause, CASE/PATH, runtime invariant or failure mode."
          },
          "assertion": {
            "type": "string"
          },
          "oracle": {
            "type": "string",
            "description": "What observable fact counts as pass/fail."
          },
          "method": {
            "type": "string"
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applicability": {
            "enum": [
              null,
              "",
              "required",
              "not_applicable"
            ]
          },
          "na_rationale": {
            "type": "string",
            "description": "Required when applicability=not_applicable: why this Claim does not apply, with evidence."
          },
          "na_checklist_id": {
            "type": "string",
            "minLength": 1,
            "description": "Optional reference to the professional N/A analysis, when one exists."
          },
          "source_refs": {
            "type": [
              "array",
              "null"
            ],
            "description": "REQ, risk, impact, BUG history, Closing Contract or CASE/PATH sources. N/A decisions need sources too.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "focus_key": {
            "type": "string",
            "description": "Round-local professional focus used for Assignment grouping; no global registry or minimum count."
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resource_locks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assignments": {
      "type": "array",
      "description": "Claim responsibility grouping and DAG projection. One Assignment may cover several same-lens Claims; the exact-set coverage rules are enforced by the plan validator.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment_id",
          "lens",
          "claim_ids",
          "non_overlap_boundary",
          "execution_wave"
        ],
        "properties": {
          "assignment_id": {
            "type": "string",
            "pattern": "^assignment-[A-Za-z0-9._-]+$"
          },
          "lens": {
            "enum": [
              "delivery",
              "qa",
              "e2e"
            ]
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "focus_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "non_overlap_boundary": {
            "type": "string",
            "description": "What this Assignment owns and what adjacent Reviewers must not redo."
          },
          "execution_wave": {
            "enum": [
              "static",
              "behavior"
            ],
            "description": "Labels for the nature of the assigned review: static or behavior. Dispatch executable responsibilities using their actual explicit depends_on relationships; these labels do not create global dependencies between assignments."
          },
          "behavior_surface": {
            "enum": [
              "browser",
              "non_browser"
            ],
            "description": "Optional behavior source fact for E2E responsibility and method selection when known."
          },
          "resource_locks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "e2e_coverage_state": {
      "enum": [
        null,
        "",
        "cold_start",
        "regression_available",
        "not_applicable"
      ]
    },
    "verification_artifact_workspace": {
      "type": [
        "string",
        "null"
      ],
      "description": "Only for e2e cold_start: the isolated write surface for new E2E spec/fixture/evidence. Writes outside this surface during verification are hard-denied."
    },
    "dispatch_capacity_policy": {
      "type": "string",
      "description": "Optional description of the planned dispatch capacity arrangement."
    },
    "coverage_justification": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional professional explanation of the chosen review scope."
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
