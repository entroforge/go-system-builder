{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding.local/schemas/repair-result-blocker.schema.json",
  "title": "Original S9 RepairResult blocker artifact",
  "description": "Preserves one full issued professional answer and its exact execution/message tuple. Acceptance coordinates are supplied by the original receipt.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract",
    "schema_version",
    "packet_id",
    "issuance_event_id",
    "binding",
    "execution_assignment_id",
    "execution_generation",
    "execution_root",
    "platform_session_id",
    "answer_path",
    "submitted_answer",
    "message_ref"
  ],
  "properties": {
    "contract": {
      "const": "s9-repair-result-blocker-v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^packet-[A-Za-z0-9_-]+$"
    },
    "issuance_event_id": {
      "type": "string",
      "pattern": "^evt-repair-result-packet-packet-[A-Za-z0-9_-]+$"
    },
    "binding": {
      "$ref": "repair-result-work-packet.schema.json#/$defs/binding"
    },
    "execution_assignment_id": {
      "type": "string",
      "pattern": "^(repair-)?assignment-[A-Za-z0-9._-]+$"
    },
    "execution_generation": {
      "type": "integer",
      "minimum": 1
    },
    "execution_root": {
      "type": "string",
      "minLength": 1
    },
    "platform_session_id": {
      "type": "string"
    },
    "answer_path": {
      "type": "string",
      "minLength": 1
    },
    "submitted_answer": {
      "type": "object",
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "blocked",
            "contract_conflict",
            "stale"
          ]
        }
      }
    },
    "message_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
