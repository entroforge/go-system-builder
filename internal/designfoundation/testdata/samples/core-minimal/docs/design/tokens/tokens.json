{
  "$description": "Starter Project Design Tokens (DTCG 2025.10). Primitive values are a temporary scale for the template factory — replace them after F4 from Design Grammar. Semantic role names are stable and must map to a Grammar rule. Do not add page-level tokens such as page-login-button-hover.",
  "color": {
    "primitive": {
      "slate-50": { "$type": "color", "$value": "#f8fafc" },
      "white": { "$type": "color", "$value": "#ffffff" },
      "slate-200": { "$type": "color", "$value": "#e2e8f0" },
      "slate-300": { "$type": "color", "$value": "#cbd5e1" },
      "slate-900": { "$type": "color", "$value": "#0f172a" },
      "slate-500": { "$type": "color", "$value": "#64748b" },
      "blue-600": { "$type": "color", "$value": "#2563eb" },
      "emerald-500": { "$type": "color", "$value": "#10b981" },
      "amber-500": { "$type": "color", "$value": "#f59e0b" },
      "red-500": { "$type": "color", "$value": "#ef4444" },
      "indigo-500": { "$type": "color", "$value": "#6366f1" }
    },
    "surface": {
      "page": {
        "$type": "color",
        "$value": "{color.primitive.slate-50}",
        "$description": "Grammar Color: page environment. Back-ref LAW-01 evidence before action."
      },
      "raised": {
        "$type": "color",
        "$value": "{color.primitive.white}",
        "$description": "Grammar Shape & Surface: content sits on a quieter raised plane."
      }
    },
    "content": {
      "ink": {
        "$type": "color",
        "$value": "{color.primitive.slate-900}",
        "$description": "Grammar Typography/Color: primary readable content."
      },
      "meta": {
        "$type": "color",
        "$value": "{color.primitive.slate-500}",
        "$description": "Grammar Typography: timestamps, sources, secondary labels."
      },
      "border": {
        "$type": "color",
        "$value": "{color.primitive.slate-200}",
        "$description": "Grammar Shape & Surface: default separation, not emphasis."
      },
      "border-strong": {
        "$type": "color",
        "$value": "{color.primitive.slate-300}",
        "$description": "Grammar Shape & Surface: stronger separation when density rises."
      }
    },
    "action": {
      "promise": {
        "$type": "color",
        "$value": "{color.primitive.blue-600}",
        "$description": "Grammar Color/Interaction: the single promise-type action. Emphasis is scarce."
      }
    },
    "status": {
      "success": { "$type": "color", "$value": "{color.primitive.emerald-500}", "$description": "Grammar Interaction: completed, recoverable success." },
      "warning": { "$type": "color", "$value": "{color.primitive.amber-500}", "$description": "Grammar Interaction: caution before a promise." },
      "blocking": { "$type": "color", "$value": "{color.primitive.red-500}", "$description": "Grammar Interaction: error, permission, or irreversible stop." },
      "info": { "$type": "color", "$value": "{color.primitive.indigo-500}", "$description": "Grammar Interaction: neutral status, never a second primary CTA." }
    },
    "brand": {
      "mark": {
        "$type": "color",
        "$value": "{color.action.promise}",
        "$description": "Grammar Color: brand mark reuses the promise action until F4 defines a distinct brand role."
      }
    }
  },
  "font": {
    "family": {
      "ui": { "$type": "fontFamily", "$value": ["system-ui", "Segoe UI", "sans-serif"] }
    },
    "size": {
      "body": { "$type": "dimension", "$value": "16px" },
      "headline": { "$type": "dimension", "$value": "28px" },
      "meta": { "$type": "dimension", "$value": "12px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" }
  },
  "rounded": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" }
  }
}
