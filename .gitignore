# Local Claude / agent runtime state (workspace-local; never commit)
.claude/

# Project-instance files (local to each target project; never commit back)
AGENTS.md
/docs/project-map.md
/docs/requirements/REQ-[0-9]*.md

# Go build and test artifacts
/bin/
/build/
/dist/
/loop-harness
*.test
*.coverprofile
coverage.out
coverage.html
*.prof
*.pprof

# Project-local temporary files
/tmp/
/temp/
*.tmp

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Python tooling artifacts
__pycache__/
*.pyc

# Operating-system files
.DS_Store
Thumbs.db

# Local configuration and secrets
.env
.env.*
!.env.example

# Logs
*.log

# Local framework maintenance archives (not reusable template assets)
/.local/
