{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["order_id"],
      "additionalProperties": false,
      "properties": {"order_id": {"type": "string", "minLength": 1}}
    },
    "response": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {"state": {"enum": ["cancelled", "completed"]}}
    }
  }
}
