{
  "schema_version": "1.2.0",
  "policy_id": "hook-policy-loop-engineering",
  "version": "v2.0.0",
  "mode": "enforce",
  "available_profiles": {
    "enforce": {"default": true, "description": "Default deterministic guardrails."},
    "audit": {"default": false, "description": "Explicit local development diagnostics."}
  },
  "protected_events": ["PreToolUse", "SessionStart", "SubagentStart", "SubagentStop", "TeammateIdle", "Stop", "PreCompact", "PostToolUse", "PostToolUseFailure", "ConfigChange"],
  "protected_paths": [
    ".claude/settings.json", ".claude/agents/", "docs/control/hook-policy.json",
    "docs/control/loop-definition.json"
  ],
  "extension_protected_commands": [],
  "rules": [
    {"rule_id":"HOOK_LOCKED_ARTIFACT_WRITE","event":"PreToolUse","matcher":"Write|Edit|MultiEdit|NotebookEdit|Bash","predicate":"locked_artifact_write","classification":"block","reason":"locked_artifact_write","missing":["new generation of the locked artifact"],"recovery":["create a new generation under the canonical kind root (requirements=docs/requirements/; contracts=docs/dev/contracts/; tasks/dispatch plans=docs/dev/tasks/; architecture=docs/architecture/; design/UI baselines=docs/design/; UI prototypes=docs/design/prototypes/) at versions/{REQ-ID}/g{N+1}/{canonical-file-name}; unknown kinds require the formal rework path"],"retry":"never","human_required":true},
    {"rule_id":"HOOK_SQUASH_MERGE","event":"PreToolUse","matcher":"Bash","predicate":"squash_merge","classification":"deny","reason":"squash_merge","missing":["normal merge without --squash"],"recovery":["use a normal merge without squash"],"retry":"rerun after recovery validation","human_required":false}
  ]
}
